<?xml version="1.0" encoding="utf-8"?>
<project
	xmlns="http://lime.openfl.org/project/1.0.4"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://lime.openfl.org/project/1.0.4 http://lime.openfl.org/xsd/project-1.0.4.xsd">
	<!-- _________________________ Application Settings _________________________ -->

	<app title="Friday Night Funkin': P-Slice NX"
		file="PSliceNX" packageName="com.studio.multidrusa.pslicenx" package="com.studio.multidrusa.pslicenx"
		main="Main" version="3.4.2" company="Studio Multidrusa" />

	<!--Switch App ID and Meta-->
	<set name="APP_ID" value="0x0100f6c013bbc000" />
	<meta build-number="342" />

	<haxedef name="LINC_LUA_RELATIVE_DYNAMIC_LIB" />

	<app preloader="mikolka.vslice.FunkinPreloader" />

	<set name="SWF_VERSION" value="11.8" />

	<!-- ______________________ PSYCH ENGINE CUSTOMIZATION ______________________ -->

	<!-- Compiles mod support for P-Slice -->
	<define name="MODS_ALLOWED" if="desktop || mobile || switch" />

	<section unless="debug">
		<define name="OPENFL_LOOKUP" />
		<define name="NATIVE_LOOKUP" if="MODS_ALLOWED" />
	</section>

	<!-- Adds support for Psych's lua/HScript files-->
	<define name="HSCRIPT_ALLOWED" if="desktop || mobile || switch" />
	<define name="LUA_ALLOWED" if="cpp" />

	<!-- Discord RPC disabled for Switch -->
	<define name="DISCORD_ALLOWED" if="desktop" unless="hl" />

	<define name="BASE_GAME_FILES"/>

	<!-- Touch controls disabled or adapted for Switch -->
	<define name="TOUCH_CONTROLS_ALLOWED" if="mobile || web || debug" />

	<define name="CHECK_FOR_UPDATES" unless="web || hl || switch" />

	<!-- Videos allowed via hxvlc -->
	<define name="VIDEOS_ALLOWED" if="desktop || mobile || web || switch" unless="32bits || hl" />

	<define name="ATSC_SUPPORT" unless="web"/>

	<define name="ACHIEVEMENTS_ALLOWED" />
	<define name="TRANSLATIONS_ALLOWED" unless="web" />

	<define name="SHOW_LOADING_SCREEN" />
	<define name="STRICT_LOADING_SCREEN" if="mobile SHOW_LOADING_SCREEN" />

	<define name="MULTITHREADED_LOADING" if="cpp" />
	<define name="PSYCH_WATERMARKS" />
	<define name="TITLE_SCREEN_EASTER_EGG" />

	<!-- Debug utilities -->
	<section if="debug">
		<define name="OPENFL_LOOKUP" />
		<define unless="html5" name="NATIVE_LOOKUP" />
		<define name="IRIS_DEBUG" />
		<define name="FEATURE_DEBUG_FUNCTIONS" />
		<haxedef name="HXVLC_VERBOSE" value="2" />
		<haxedef name="HXVLC_LOGGING" />
		<define name="pico_always_kill" />
	</section>

	<!-- ____________________________ Window Settings ___________________________ -->

	<window width="1280" height="720" fps="60" background="#000000" hardware="true" vsync="false"
		allow-high-dpi="true" />

	<!--HTML5-specific-->
	<window if="html5" resizable="true" fullscreen="true" />

	<!--Desktop-specific-->
	<window if="desktop" orientation="landscape" fullscreen="false" resizable="true" vsync="false" />

	<!--Mobile-specific-->
	<window if="mobile" orientation="landscape" fullscreen="true" resizable="false"
		allow-shaders="true" require-shaders="true" />

	<!--Switch-specific (Forçado a 720p/1080p nativo em fullscreen landscape)-->
	<window if="switch" orientation="landscape" fullscreen="true" width="1280" height="720"
		resizable="false" vsync="false" />

	<!-- _____________________________ Path Settings ____________________________ -->

	<set name="BUILD_DIR" value="export/debug" if="debug" />
	<set name="BUILD_DIR" value="export/switch" if="switch" />
	<set name="BUILD_DIR" value="export/release" unless="debug || switch" />

	<classpath name="source" />

	<!-- __________________________ Game Assets & Etc. __________________________ -->

	<section if="desktop">
		<assets path="alsoft.txt" rename="plugins/alsoft.ini" type="text" if="windows" />
		<assets path="alsoft.txt" rename="plugins/alsoft.conf" type="text" unless="windows" />
	</section>

	<!-- Assets -->
	<assets path="assets/fonts" />
	<assets path="assets/videos" if="VIDEOS_ALLOWED" embed="false"/>

	<assets path="assets/shared" unless="web" />
	<assets path="assets/shared" if="web" embed="true" />

	<assets path="assets/embed" if="web" embed="true" />
	<assets path="assets/embed" unless="web || OPENFL_LOOKUP" embed="false" />
	<assets path="assets/embed" if="OPENFL_LOOKUP" unless="web" embed="true" />

	<assets path="assets/week_assets" rename="assets" />

	<section if="TITLE_SCREEN_EASTER_EGG">
		<assets path="assets/secrets" rename="assets/shared" unless="web" />
	</section>

	<section if="TRANSLATIONS_ALLOWED">
		<assets path="assets/translations" rename="assets" unless="web" />
	</section>

	<assets path="assets/atsc_shared" rename="assets/shared" />

	<section if="BASE_GAME_FILES">
		<assets path="assets/base_game/week_data" rename="assets" unless="web" />
		<assets path="assets/base_game/characters" rename="assets/shared/images/characters" unless="web" />
		<assets path="assets/base_game/characters_pixel" rename="assets/shared/images/characters" unless="web" />
		<assets path="assets/base_game/shared" rename="assets/shared" unless="web" />
	</section>

	<section if="MODS_ALLOWED">
		<assets path='example_mods' rename='mods' embed='false' />
	</section>

	<!-- _______________________________ Haxe libs ______________________________ -->

	<haxelib name="flixel" />
	<haxelib name="flixel-addons" version="3.3.2" />
	<haxelib name="hxcpp" />
	<haxelib name="tjson" version="1.4.0" />
	<haxelib name="grig.audio" />
	<haxelib name="funkin.vis" />

	<!--Psych stuff needed-->
	<haxelib name="linc_luajit" if="LUA_ALLOWED" />
	<haxelib name="hscript-iris" if="HSCRIPT_ALLOWED" version="1.1.3" />
	
	<section if="VIDEOS_ALLOWED" unless="web">
		<haxelib name="hxCodec" if="linux" />
		<haxelib name="hxvlc" unless="linux" />
	</section>

	<haxelib name="flxanimate" />

	<!-- ______________________________ Haxedefines _____________________________ -->

	<haxedef name="FLX_NO_FOCUS_LOST_SCREEN" />
	<haxedef name="FLX_NO_DEBUG" unless="debug" />
	<haxedef name="analyzer-optimize" unless="debug" />
	<haxedef name="NAPE_RELEASE_BUILD" unless="debug" />

	<define name="SHUT_UP_LINC_LUAJIT" />

	<section if="cpp">
		<haxedef name="HXCPP_CHECK_POINTER" />
		<haxedef name="HXCPP_STACK_LINE" />
		<haxedef name="HXCPP_STACK_TRACE" />
		<haxedef name="HXCPP_CATCH_SEGV" />
	</section>

	<haxedef name='no-deprecation-warnings' />
	<haxedef name='lime_disable_assets_version' />

	<haxedef name="message.reporting" value="pretty" />

	<haxeflag name="--macro" value="allowPackage('flash')" />
	<haxeflag name="--macro" value="include('my.pack')" />
	<haxeflag name="--macro" value="addMetadata('@:build(mikolka.FlxMacro.buildFlxBasic())', 'flixel.FlxBasic')" />

	<haxedef name="hscriptPos" if="HSCRIPT_ALLOWED" />

	<!-- _________________________________ Icons ________________________________ -->
	
	<icon path="art/desktop/iconOG.png" />

</project>
